<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>safesharp</ToolCommandName>
    <Description>Command-line ownership analysis with source-linked graphs and reports for C# projects and solutions.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../SafeSharp.Analyzers/SafeSharp.Analyzers.csproj" />
    <ProjectReference Include="../SafeSharp.Contracts/SafeSharp.Contracts.csproj" />
    <ProjectReference Include="../SafeSharp.Reporting/SafeSharp.Reporting.csproj" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.9.0" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" Version="5.9.0" />
    <PackageReference Include="Microsoft.Build.Locator" Version="1.11.2" />
    <!-- MSBuild is loaded from the installed SDK by Locator, never from the tool payload. -->
    <PackageReference Include="Microsoft.Build.Framework" Version="17.14.28" ExcludeAssets="runtime" PrivateAssets="all" />
  </ItemGroup>
</Project>
